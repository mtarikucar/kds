# Production Environment Configuration Template
# Copy this to .env.production on your server and fill in the values

NODE_ENV=production

# Database Configuration
POSTGRES_DB=restaurant_pos_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/restaurant_pos_prod

# Redis Configuration
REDIS_URL=redis://redis:6379/2

# Server Configuration
PORT=3000
FRONTEND_PORT=80

# JWT Configuration - CHANGE THESE TO RANDOM SECURE VALUES
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_SECRET_64_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com

# PayTR Payment Provider (Turkey) — the only collection rail. Required in
# production: the backend refuses to boot without merchant id/key/salt and
# the two redirect URLs (backend/src/common/helpers/env-validation.ts).
# PAYTR_TEST_MODE must be "0" in production.
PAYTR_MERCHANT_ID=your_merchant_id
PAYTR_MERCHANT_KEY=your_merchant_key
PAYTR_MERCHANT_SALT=your_merchant_salt
PAYTR_OK_URL=https://yourdomain.com/app/subscription/success
PAYTR_FAIL_URL=https://yourdomain.com/app/subscription/fail
# Optional: separate redirect targets for the QR-menu customer self-pay flow.
# Fall back to PAYTR_OK_URL / PAYTR_FAIL_URL when unset.
PAYTR_OK_URL_POS=https://yourdomain.com/payment-result
PAYTR_FAIL_URL_POS=https://yourdomain.com/payment-result
PAYTR_TEST_MODE=0

# Email Configuration (Production)
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_SECURE=true
EMAIL_USER=your_email@domain.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@yourdomain.com
# Alert recipient for the monitoring stack (Alertmanager emails alerts here).
ADMIN_EMAIL=alerts@yourdomain.com

# Observability / monitoring (self-hosted Prometheus + Grafana + Alertmanager)
# METRICS_TOKEN: bearer guarding GET /api/metrics (backend fails closed in prod
# if unset). GRAFANA_ADMIN_PASSWORD: Grafana login; monitoring stays inert until set.
METRICS_TOKEN=change_me_32plus_random_chars
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend Environment Variables
VITE_API_URL=https://api.yourdomain.com
VITE_WS_URL=wss://api.yourdomain.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
